<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/widget_glass_background">

    <TextView
        android:id="@+id/choose_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Show me:"
        android:textSize="14sp"
        android:textColor="@color/widget_text_primary"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/choose_tasks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:background="@drawable/widget_choose_pill_background"
            android:text="✅ Todo"
            android:textAllCaps="false"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/choose_habits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="18dp"
            android:paddingVertical="12dp"
            android:background="@drawable/widget_choose_pill_background"
            android:text="💪 Routines"
            android:textAllCaps="false"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
