{
  "permissions": {
    "deny": [
      "Read(**/*.g.dart)",
      "Read(**/*.freezed.dart)",
      "Read(**/*.mocks.dart)",
      "Read(**/build/**)",
      "Read(**/.dart_tool/**)",
      "Read(**/ios/Pods/**)",
      "Bash(flutter run*)",
      "Bash(flutter build*)",
      "Bash(flutter pub outdated*)",
      "Bash(pod install*)",
      "Bash(./gradlew*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/dart-check.sh",
            "args": [],
            "timeout": 60,
            "statusMessage": "Checking Dart"
          }
        ]
      }
    ]
  }
}